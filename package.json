{
  "name": "ravensight-docs-mcp",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Public read-only access to Ravensight product documentation over MCP",
  "license": "MIT",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "start": "node src/local.mjs",
    "test": "npm run build && node --test test/*.test.mjs",
    "build": "node scripts/build.mjs",
    "hooks:install": "git config core.hooksPath .githooks",
    "prepare": "node -e \"try{require('child_process').execFileSync('git',['config','core.hooksPath','.githooks'],{stdio:'ignore'})}catch(e){}\""
  },
  "dependencies": {
    "@modelcontextprotocol/server": "2.3.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@modelcontextprotocol/client": "2.3.1",
    "esbuild": "0.28.2"
  }
}
